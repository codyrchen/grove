# Copy to .env and fill in. .env is ignored by git; never commit it.
# On Railway, set these as service Variables instead of using a file.

# Database. Leave unset locally to use a SQLite file (grove.db).
# On Railway, reference the Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Semester dates (YYYY-MM-DD) for "Week N of the semester" in the greeting.
# SEMESTER_START=2026-08-24
# SEMESTER_END=2026-12-11

# News feeds (RSS or Atom), space-separated.
# NEWS_FEEDS=https://news.olemiss.edu/feed/

# Link to a form where fans submit campus photos (shown on the About page).
# PHOTO_SUBMIT_URL=https://forms.gle/...

# Rebels schedules: calendar (.ics) links as sport=url pairs, space-separated.
# Find them on the athletics site's schedule pages ("Download schedule" / "Sync to calendar").
# GAMEDAY_CALENDARS=football=https://.../football.ics baseball=https://.../baseball.ics
